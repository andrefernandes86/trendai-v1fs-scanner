# Copy to .env locally; never commit .env. For containers configure a dev service principal,
# workload identity, or managed identity. Host Azure CLI credentials are not mounted.
ENTRA_ISSUER=https://login.microsoftonline.com/YOUR_TENANT/v2.0
ENTRA_AUDIENCE=YOUR_API_APPLICATION_CLIENT_ID
SERVICEBUS_NAMESPACE=YOUR_NAMESPACE.servicebus.windows.net
TM_REGION=us-east-1
TM_AM_AUTH_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ENVIRONMENT=development
SIMULATED_SCANNER=false
